# systemd unit for the consumer: /etc/systemd/system/skitrak-consumer.service
# Restart=always is the auto-restart on failure; GET :8081/health is the health check
[Unit]
Description=SkiTrak consumer (assignment 2)
After=network-online.target
Wants=network-online.target

[Service]
User=ec2-user
EnvironmentFile=/etc/skitrak-consumer.env
# JVM options (heap, GC) come from JAVA_OPTS in /etc/skitrak-consumer.env
ExecStart=/usr/bin/java $JAVA_OPTS -jar /opt/skitrak-consumer/consumer.jar
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
