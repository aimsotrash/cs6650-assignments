# /etc/skitrak-consumer.env on the consumer host (read by skitrak-consumer.service)
RABBIT_HOST=BROKER_PRIVATE_IP
RABBIT_USER=skitrak
RABBIT_PASS=CHANGE_ME
# threads to start with, and the most the pool scales up to under load (never more than the 10 resort queues)
CONSUMER_THREADS=10
MAX_THREADS=10
PREFETCH=100
# one ack per 50 messages instead of one each: less broker CPU (+4-10% throughput); the end of a batch is acked
# by the consumer's 5 s flush, so nothing stays unacked when the queues go quiet
ACK_BATCH=50
TOP_N=20
HEALTH_PORT=8081
# t3.micro (1 GB): -Xmx512m. On a 1 GB machine the JVM picks the serial collector, and its full collections paused
# the consumer long enough for one 5 s queue sample to jump to 1-2K messages. On m8azn.large (8 GB), at ~30K swipes/s,
# even G1's ~40-50 ms pauses still gave one sample over 1,000; ZGC (pauses well under 1 ms) removed them:
#   JAVA_OPTS=-Xms2g -Xmx2g -XX:+UnlockExperimentalVMOptions -XX:+UseZGC
JAVA_OPTS=-Xmx512m
